# Wrap values in double quotes if they contain # % or other special characters.
#
# Production API (principles-server) — keys from front/Principles/appsettings.json:
PASSWORD_ENCRYPTION_FIRST_KEY=""
PASSWORD_ENCRYPTION_SECOND_KEY=""
#
# Local back API — keys from back/SET.WebAPI/appsettings.Development.json:
# PASSWORD_ENCRYPTION_FIRST_KEY=""
# PASSWORD_ENCRYPTION_SECOND_KEY=""

# Production build: same keys as above (exposed in client bundle).
VITE_PASSWORD_ENCRYPTION_FIRST_KEY=""
VITE_PASSWORD_ENCRYPTION_SECOND_KEY=""

# Optional API base (empty = same origin; use with reverse proxy to the backend).
VITE_API_BASE_URL=

# Dev proxy: https://principles-server.ckwavh.easypanel.host or http://localhost:6001
VITE_API_PROXY_TARGET=https://principles-server.ckwavh.easypanel.host

# Canonical site URL for SEO (sitemap, canonical, Open Graph).
VITE_SITE_URL=https://principles.top
